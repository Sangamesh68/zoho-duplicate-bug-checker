# Copy to .env and fill in. The real .env is git-ignored — never commit it.

# --- Database -------------------------------------------------------------
# Must match docker-compose.yml if you use the bundled Postgres.
DATABASE_URL=postgresql://dupchecker:dupchecker@localhost:5432/dupchecker

# --- Zoho region ----------------------------------------------------------
# Use .in for India accounts, .com elsewhere. BOTH must be the same region.
ZOHO_API_BASE=https://projectsapi.zoho.in
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in

# --- Zoho Self Client credentials (local single-user mode) ----------------
# Generate at https://api-console.zoho.in with these scopes:
#   ZohoProjects.bugs.READ,ZohoProjects.portals.READ,ZohoProjects.projects.READ,
#   ZohoProjects.users.READ,AaaServer.profile.READ
# Self Client access tokens expire in about an hour — regenerate as needed.
ZOHO_ACCESS_TOKEN=paste-your-access-token-here

# Run `python discover_ids.py` to find these two.
ZOHO_PORTAL_ID=paste-your-portal-id-here
ZOHO_PROJECT_ID=paste-your-project-id-here

# Fallback identity for the local user. seed.py prefers the email Zoho
# reports for your token and only falls back to this.
LOCAL_USER_EMAIL=you@arcitech.ai

# --- Duplicate detection tuning -------------------------------------------
# Final score = semantic * SEMANTIC_WEIGHT + keyword * KEYWORD_WEIGHT.
# Flagged as a duplicate above DUPLICATE_THRESHOLD.
DUPLICATE_THRESHOLD=0.72
SEMANTIC_WEIGHT=0.65
KEYWORD_WEIGHT=0.35
